generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Student {
  id            String       @id @default(cuid())
  name          String
  phone         String
  originalPhone String?
  group         String       // "TPE", "TCC1", "TCC2"
  advisor       String?      // Orientador
  topic         String?      // Tema de pesquisa/TCC
  email         String?
  deadline      String?      // Prazo específico se houver
  status        String       @default("ACTIVE") // ACTIVE, INACTIVE, DEFENDED
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  logs          MessageLog[]
}

model Template {
  id             String     @id @default(cuid())
  title          String
  group          String     @default("ALL") // "TPE", "TCC1", "TCC2", "ALL"
  content        String
  attachmentUrl  String?
  attachmentType String?    // "pdf", "image", "document"
  attachmentName String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  campaigns      Campaign[]
}

model Campaign {
  id              String       @id @default(cuid())
  title           String
  targetGroup     String       // "ALL", "TPE", "TCC1", "TCC2"
  templateId      String?
  template        Template?    @relation(fields: [templateId], references: [id], onDelete: SetNull)
  messageContent  String
  attachmentUrl   String?
  attachmentName  String?
  attachmentType  String?
  status          String       @default("DRAFT") // DRAFT, SCHEDULED, RUNNING, PAUSED, COMPLETED, CANCELLED
  minDelay        Int          @default(5) // segundos
  maxDelay        Int          @default(15) // segundos
  scheduledAt     DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  totalRecipients Int          @default(0)
  sentCount       Int          @default(0)
  failedCount     Int          @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  logs            MessageLog[]
}

model MessageLog {
  id              String    @id @default(cuid())
  campaignId      String?
  campaign        Campaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  studentId       String?
  student         Student?  @relation(fields: [studentId], references: [id], onDelete: SetNull)
  recipientName   String
  recipientPhone  String
  recipientGroup  String
  renderedMessage String
  hasAttachment   Boolean   @default(false)
  status          String    @default("PENDING") // PENDING, SENDING, SENT, DELIVERED, FAILED
  errorMessage    String?
  sentAt          DateTime?
  createdAt       DateTime  @default(now())
}

model Setting {
  id                String   @id @default("global")
  mockMode          Boolean  @default(false)
  defaultMinDelay   Int      @default(5)
  defaultMaxDelay   Int      @default(15)
  batchSize         Int      @default(20)
  batchPauseSeconds Int      @default(60)
  institutionName   String   @default("Coordenação de Curso")
  coordinatorName   String   @default("Prof. Coordenador de TCC")
  updatedAt         DateTime @updatedAt
}
